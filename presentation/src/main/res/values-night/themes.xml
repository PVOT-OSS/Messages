<resources>

    <style name="AppTheme" parent="AppBaseTheme" />

    <style name="AppBaseTheme" parent="PvotTheme.Dark">
        <item name="android:divider">?attr/colorOutlineVariant</item>
        <item name="android:queryBackground">?attr/colorSurfaceVariant</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="bubbleColor">?attr/colorSurfaceVariant</item>
        <item name="selectableItemBackground">@drawable/ripple_dark</item>
        <item name="switchThumbEnabled">@color/switchThumbEnabledDark</item>
        <item name="switchThumbDisabled">@color/switchThumbDisabledDark</item>
        <item name="switchTrackEnabled">@color/switchTrackEnabledDark</item>
        <item name="switchTrackDisabled">@color/switchTrackDisabledDark</item>
    </style>

    <style name="AppThemeDialog" parent="PvotTheme.Dark.Dialog">
        <item name="bubbleColor">?attr/colorSurfaceVariant</item>
        <item name="selectableItemBackground">@drawable/ripple_dark</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Black theme -->
    <style name="AppTheme.Black">
        <item name="bubbleColor">@color/bubbleBlack</item>
        <item name="colorSurfaceVariant">@color/bubbleBlack</item>
    </style>

    <style name="AppThemeDialog.Black">
        <item name="bubbleColor">@color/bubbleBlack</item>
        <item name="colorSurfaceVariant">@color/bubbleBlack</item>
    </style>

</resources>
