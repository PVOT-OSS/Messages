<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_compose"
        android:shortcutDisabledMessage="@string/shortcut_compose_disabled_message"
        android:shortcutId="compose"
        android:shortcutLongLabel="@string/shortcut_compose_long_label"
        android:shortcutShortLabel="@string/shortcut_compose_short_label">

        <intent
            android:action="org.prauga.messages.START"
            android:targetClass="org.prauga.messages.feature.compose.ComposeActivity"
            android:targetPackage="org.prauga.messages" />

        <categories android:name="android.shortcut.conversation" />

    </shortcut>

</shortcuts>
